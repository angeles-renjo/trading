# ---------------------------------------------------------------------------
# Crypto Trading Partner — configuration
# Copy to `.env.local` and adjust. All values have sensible defaults.
# ---------------------------------------------------------------------------

# Market data source: "bybit" (live public data) or "mock" (offline demo data).
MARKET_DATA_SOURCE=bybit

# Bybit V5 REST base URL.
#   Mainnet:  https://api.bybit.com
#   Testnet:  https://api-testnet.bybit.com   (use this when wiring real orders)
BYBIT_BASE_URL=https://api.bybit.com

# Bybit product category for market data and (later) trading: spot | linear | inverse
BYBIT_CATEGORY=spot

# ---- Paper trading engine -------------------------------------------------

# Starting paper balance, denominated in the quote currency below.
STARTING_BALANCE=10000

# Quote currency used for cash + notional sizing (Bybit spot pairs end in this).
QUOTE_CURRENCY=USDT

# Simulated taker fee per fill, as a fraction (0.001 = 0.10%).
FEE_RATE=0.001

# Where paper-account state (cash, positions, trades) is persisted on disk.
DATA_DIR=.data

# ---- Real trading (NOT YET WIRED — placeholders for the "real later" path) -
# When you implement BybitBroker, read keys from here. Never commit real keys.
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# TRADING_MODE=paper   # paper | live
